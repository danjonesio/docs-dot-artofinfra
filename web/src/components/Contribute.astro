---
const repoUrl = 'https://github.com/danjonesio/docs-dot-artofinfra';

const steps = [
  {
    n: '01',
    title: 'Spot the gap',
    desc: 'A wrong rule, a vendor we don\'t cover, a workflow we haven\'t documented. If you\'ve hit it in production, others will too.',
  },
  {
    n: '02',
    title: 'Edit the markdown',
    desc: 'A single .md file in docs/{category}/. Match the format of any existing doc. No tooling required, no CMS to fight.',
  },
  {
    n: '03',
    title: 'Open a PR',
    desc: 'A maintainer reviews. Nothing goes public until your PR is merged to main, at which point the docs are live within minutes and agents fetch the new rules.',
  },
];
---

<section class="border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <p class="font-mono text-xs uppercase tracking-wide text-neon-cyan/80">
      Contribute
    </p>
    <h2
      class="mt-3 max-w-[28ch] font-display text-4xl font-semibold tracking-tight text-ink text-balance sm:text-5xl"
    >
      Open source. MIT. PRs welcome.
    </h2>
    <p class="mt-4 max-w-[58ch] text-pretty text-base text-ink-muted sm:text-lg">
      Every rule here ends up in someone's network. If you've hit an edge case, a vendor we don't cover, or wrong syntax, fork the repo and send a PR. No CMS, no auth review. Just markdown.
    </p>

    <ol role="list" class="mt-12 grid gap-4 sm:gap-6 lg:grid-cols-3">
      {steps.map((s) => (
        <li class="relative overflow-hidden rounded-xl bg-bg-raised/70 p-6 ring-1 ring-inset ring-white/5 sm:p-7">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-neon-cyan neon-cyan">{s.n}</span>
            <span class="h-px flex-1 bg-gradient-to-r from-neon-cyan/40 to-transparent"></span>
          </div>
          <h3 class="mt-5 font-display text-xl font-medium tracking-tight text-ink">
            {s.title}
          </h3>
          <p class="mt-3 max-w-[40ch] text-pretty text-sm text-ink-muted sm:text-base">
            {s.desc}
          </p>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href={repoUrl}
        class="inline-flex items-center gap-2 rounded-md bg-bg-raised/80 px-5 py-2.5 text-sm font-semibold text-ink ring-1 ring-inset ring-white/15 hover:bg-bg-raised hover:text-neon-cyan hover:ring-neon-cyan/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon-cyan"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4 shrink-0">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        View on GitHub
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0">
          <path d="M7 7h10v10"/>
          <path d="M7 17 17 7"/>
        </svg>
      </a>
      <a
        href={`${repoUrl}/blob/main/CONTRIBUTING.md`}
        class="inline-flex items-center gap-2 text-sm font-semibold text-ink-muted hover:text-ink"
      >
        Contribution guide
      </a>
    </div>
  </div>
</section>
