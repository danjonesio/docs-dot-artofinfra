---
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const agents = [
  { id: 'claude',   label: 'Claude Code', target: '.claude/skills/artofinfra/SKILL.md',     file: 'skills/claude/SKILL.md' },
  { id: 'cursor',   label: 'Cursor',      target: '.cursor/rules/artofinfra.mdc',           file: 'skills/cursor/artofinfra.mdc' },
  { id: 'codex',    label: 'Codex',       target: '.codex/skills/artofinfra/SKILL.md',      file: 'skills/codex/SKILL.md' },
  { id: 'opencode', label: 'OpenCode',    target: '.opencode/skills/artofinfra/SKILL.md',   file: 'skills/opencode/SKILL.md' },
  { id: 'amp',      label: 'Amp',         target: '.amp/skills/artofinfra/SKILL.md',        file: 'skills/amp/SKILL.md' },
];

// Resolve repo root from this file's location so the path is correct regardless
// of where `npm run build` is invoked from. This component lives at
// web/src/components/Install.astro, so the repo root is three levels up.
const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
const snippets = agents.map((a) => ({
  ...a,
  contents: fs.readFileSync(path.join(repoRoot, a.file), 'utf8').trimEnd(),
}));
---

<section id="install" class="border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <p class="font-mono text-xs uppercase tracking-wide text-neon-cyan/80">
      Install
    </p>
    <h2
      class="mt-3 max-w-[28ch] font-display text-4xl font-semibold tracking-tight text-ink text-balance sm:text-5xl"
    >
      One command. Pick your agent.
    </h2>
    <p class="mt-4 max-w-[58ch] text-pretty text-base text-ink-muted sm:text-lg">
      Run the installer for an interactive picker, or copy-paste the SKILL file from a tab below.
    </p>

    <!-- CLI install (primary path) -->
    <div class="relative mt-12 overflow-hidden rounded-xl bg-bg-panel ring-1 ring-inset ring-neon-magenta/30 shadow-glow-magenta">
      <div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-12 size-40 rounded-full bg-neon-magenta/20 blur-2xl"></div>
      <div class="relative px-5 py-5 sm:px-7 sm:py-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="font-mono text-xs uppercase tracking-wide text-neon-magenta neon-magenta">
            Recommended
          </p>
          <span class="font-mono text-[10px] uppercase tracking-wide text-ink-dim">@artofinfra/install on npm</span>
        </div>
        <div class="mt-4 flex items-center gap-3 rounded-lg bg-bg ring-1 ring-inset ring-white/5 px-4 py-3.5">
          <span class="font-mono text-sm text-ink-dim shrink-0">$</span>
          <code
            data-copy-cli-source
            class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap font-mono text-sm text-ink"
          >npx @artofinfra/install</code>
          <button
            type="button"
            data-copy-cli
            aria-label="Copy install command"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-neon-magenta/15 px-3 py-1.5 font-mono text-xs font-semibold text-neon-magenta ring-1 ring-inset ring-neon-magenta/30 hover:bg-neon-magenta/25"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span data-copy-cli-label>Copy</span>
          </button>
        </div>
        <p class="mt-4 max-w-[58ch] text-pretty text-sm text-ink-muted">
          Asks which agent(s) you want, then writes the matching SKILL file to its conventional path.
        </p>
      </div>
    </div>

    <!-- Manual install (fallback) -->
    <p class="mt-12 font-mono text-xs uppercase tracking-wide text-neon-cyan/80">
      Or copy-paste manually
    </p>

    <div data-install-tabs class="mt-5 overflow-hidden rounded-xl bg-bg-panel/80 ring-1 ring-inset ring-white/10">
      <!-- Tab list -->
      <div role="tablist" aria-label="Agents" class="flex flex-wrap border-b border-white/5 px-2 pt-2">
        {snippets.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={s.id}
            class="rounded-t-md px-4 py-2.5 font-mono text-xs uppercase tracking-wide text-ink-muted hover:text-ink aria-selected:bg-bg-raised aria-selected:text-neon-magenta aria-selected:neon-magenta"
          >
            {s.label}
          </button>
        ))}
      </div>

      <!-- Panels -->
      {snippets.map((s, i) => (
        <section
          role="tabpanel"
          id={`panel-${s.id}`}
          aria-labelledby={`tab-${s.id}`}
          data-panel={s.id}
          hidden={i !== 0}
          class="px-5 py-6 sm:px-7 sm:py-7"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="font-mono text-xs text-ink-muted">
              Target path:&nbsp;
              <code class="rounded bg-white/5 px-1.5 py-0.5 text-neon-cyan">{s.target}</code>
            </p>
            <button
              type="button"
              data-copy={s.id}
              class="inline-flex items-center gap-1.5 rounded-md bg-neon-magenta/15 px-3 py-1.5 text-xs font-semibold text-neon-magenta ring-1 ring-inset ring-neon-magenta/30 hover:bg-neon-magenta/25"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre data-copy-source={s.id} class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-bg ring-1 ring-inset ring-white/5 p-4 font-mono text-[12.5px] leading-6 text-ink/85">{s.contents}</pre>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  // Tab + per-tab copy buttons (unchanged)
  const containers = document.querySelectorAll<HTMLElement>('[data-install-tabs]');
  containers.forEach((container) => {
    const tabs = container.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = container.querySelectorAll<HTMLElement>('[data-panel]');

    function select(id: string) {
      tabs.forEach((t) => {
        const active = t.dataset.tab === id;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((p) => {
        const active = p.dataset.panel === id;
        if (active) {
          p.removeAttribute('hidden');
        } else {
          p.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        if (t.dataset.tab) select(t.dataset.tab);
      });
    });

    container.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.copy;
        if (!id) return;
        const src = container.querySelector<HTMLElement>(`[data-copy-source="${id}"]`);
        if (!src) return;
        try {
          await navigator.clipboard.writeText(src.textContent ?? '');
          const label = btn.querySelector<HTMLElement>('[data-copy-label]');
          if (label) {
            const prev = label.textContent;
            label.textContent = 'Copied';
            setTimeout(() => { label.textContent = prev; }, 1500);
          }
        } catch {
          /* clipboard may be unavailable */
        }
      });
    });
  });

  // CLI command copy button (new)
  const cliBtn = document.querySelector<HTMLButtonElement>('[data-copy-cli]');
  const cliSrc = document.querySelector<HTMLElement>('[data-copy-cli-source]');
  if (cliBtn && cliSrc) {
    cliBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cliSrc.textContent?.trim() ?? '');
        const label = cliBtn.querySelector<HTMLElement>('[data-copy-cli-label]');
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied';
          setTimeout(() => { label.textContent = prev; }, 1500);
        }
      } catch {
        /* clipboard may be unavailable */
      }
    });
  }
</script>
