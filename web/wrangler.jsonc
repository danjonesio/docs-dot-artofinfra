{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-dot-artofinfra",
  "compatibility_date": "2026-05-17",
  "main": "./worker.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
